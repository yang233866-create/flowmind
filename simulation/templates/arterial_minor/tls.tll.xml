    <connection from="E_in" to="W_out" fromLane="0" toLane="0" tls="TL" linkIndex="4"/>
    <connection from="E_in" to="W_out" fromLane="1" toLane="1" tls="TL" linkIndex="5"/>
    <connection from="E_in" to="W_out" fromLane="2" toLane="2" tls="TL" linkIndex="6"/>
    <connection from="E_in" to="S_out" fromLane="2" toLane="0" tls="TL" linkIndex="7"/>
    <connection from="S_in" to="E_out" fromLane="0" toLane="0" tls="TL" linkIndex="8"/>
    <connection from="S_in" to="N_out" fromLane="0" toLane="0" tls="TL" linkIndex="9"/>
    <connection from="S_in" to="W_out" fromLane="0" toLane="2" tls="TL" linkIndex="10"/>
