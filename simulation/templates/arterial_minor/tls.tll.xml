<tlLogics>
    <!-- static program "0": arterial (EW) green 45 / yellow 3 / minor (NS) green 20 / yellow 3.
         link index layout:
         N=0..2 (right, straight, left), E=3..7 (right, straight-l0, straight-l1, straight-l2, left),
         S=8..10 (right, straight, left), W=11..15 (right, straight-l0, straight-l1, straight-l2, left) -->
    <tlLogic id="TL" type="static" programID="0" offset="0">
        <phase duration="45" state="rrrGGGGgrrrGGGGg"/>
        <phase duration="3"  state="rrryyyyyrrryyyyy"/>
        <phase duration="20" state="GGgrrrrrGGgrrrrr"/>
        <phase duration="3"  state="yyyrrrrryyyrrrrr"/>
    </tlLogic>

    <connection from="N_in" to="W_out" fromLane="0" toLane="0" tls="TL" linkIndex="0"/>
